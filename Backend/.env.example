# Copy to .env and fill in. The server refuses to start if any of these are missing.

# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb://127.0.0.1:27017/interview-copilot

# Secret used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Google AI Studio API key: https://aistudio.google.com/apikey
GOOGLE_GENAI_API_KEY=your-gemini-api-key

# Origin allowed to send credentialed requests (the frontend dev server or the deployed URL)
FRONTEND_URL=http://localhost:5173

# Optional
PORT=5000
NODE_ENV=development
